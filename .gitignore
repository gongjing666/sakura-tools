# Development tooling (PHPStan / WordPress stubs) is not shipped with the plugin.
# vendor/s3 is production runtime code (Strauss-prefixed AWS SDK) and is tracked.
/vendor/*
!/vendor/s3/
/vendor/s3/vendor/

# Release artifacts
/dist/

# PHPUnit cache
/.phpunit.cache/
.phpunit.result.cache

# Local editor / OS noise
.DS_Store
.idea/
.vscode/
*.log

# DSH ops panel captures (runtime artifacts written into cwd, never shipped)
.dsh-ops/

# Node tooling for the admin islands (bin/build-ui.mjs)
/node_modules/
