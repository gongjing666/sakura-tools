{
    "name": "sakura/tools",
    "description": "樱花工具箱 (Sakura Tools) WordPress plugin, development tooling only.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "lint": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "lint:fix": "phpcbf",
        "lint:strict": "phpcs",
        "lint:compat": "phpcs --standard=phpcs-compat.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "Sakura\\ImageOptimizer\\": "src/",
            "Nboke\\UserFiles\\": "src/UserFiles/"
        }
    }
}
