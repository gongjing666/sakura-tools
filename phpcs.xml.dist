<?xml version="1.0"?>
<ruleset name="Sakura Tools">
	<description>WordPress Coding Standards for 樱花工具箱 (Sakura Tools).</description>

	<file>sakura-tools.php</file>
	<file>uninstall.php</file>
	<file>src/</file>
	<file>includes/</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/docs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="minimum_supported_wp_version" value="6.5"/>

	<!--
		WordPress-Extra, minus the pure-formatting sniffs.

		These are excluded on purpose: the codebase has a consistent house style
		that differs from WPCS in whitespace/alignment only, and enforcing it
		would produce a ~1900-hunk reformat that touches every file without
		changing behaviour. Security, i18n, SQL, escaping and API-usage sniffs
		stay enabled.
	-->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayIndentation"/>
		<exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.DisallowMultipleStatements"/>
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
		<exclude name="Generic.Strings.UnnecessaryStringConcat"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="Squiz.WhiteSpace.SuperfluousWhitespace"/>
		<exclude name="Squiz.Strings.DoubleQuoteUsage"/>
		<exclude name="PSR2.Classes.ClassDeclaration"/>
		<exclude name="PSR2.Namespaces.NamespaceDeclaration"/>
		<exclude name="PSR2.Methods.FunctionClosingBrace"/>
		<exclude name="PSR12.Functions.ReturnTypeDeclaration"/>
		<exclude name="Modernize.FunctionCalls.Dirname"/>
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>

		<!--
			File naming: this plugin intentionally uses class-*.php in includes/
			and snake_case in src/ (PSR-4 autoloading via a hand-written loader).
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!--
		Known warnings (29) are dynamic-SQL false positives: IN (...) lists are
		built with implode( ',', array_fill( 0, count( $ids ), '%d' ) ), which the
		PreparedSQLPlaceholders sniff cannot count statically. Every query was
		reviewed by hand; see docs in the audit report.
	-->

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sakura-imgopt"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sakura_imgopt"/>
				<element value="sakura_tools"/>
				<element value="sufm"/>
				<element value="sakura"/>
				<element value="Nboke"/>
			</property>
		</properties>
		<!--
			includes/views/*.php are template partials included inside a method;
			their variables are locals of the including scope, not globals.
		-->
		<exclude-pattern>includes/views/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="sufm_manage_media_folders"/>
				<element value="sufm_transfer_media_files"/>
				<element value="sufm_manage_own_files"/>
				<element value="sufm_request_delete_own_files"/>
				<element value="sufm_admin_delete_files"/>
				<element value="sufm_admin_review_deletions"/>
			</property>
		</properties>
	</rule>

	<!--
		Patterns that are correct here but that the sniffs cannot see through.

		These are excluded rather than downgraded: PHPCS applies a ruleset
		severity only to sniffs that call addWarning(); the WPCS sniffs below
		emit errors directly, so a <severity> override is silently ignored
		(verified with phpcs 3.13.6).

		Each exclusion names the invariant that makes it safe, so a reviewer
		can tell whether the invariant still holds.
	-->

	<!--
		Table names always come from Schema::table(), never from request data;
		every value is still passed through $wpdb->prepare(). The placeholder
		sniffs stay enabled and do catch real mistakes.
	-->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL.NotPrepared">
		<severity>0</severity>
	</rule>

	<!-- REST routes authenticate via X-WP-Nonce, enforced by WP core. -->
	<rule ref="WordPress.Security.NonceVerification.Missing">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.Security.NonceVerification.Recommended">
		<severity>0</severity>
	</rule>

	<!-- Moving/copying files is this plugin's job. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<severity>0</severity>
	</rule>

	<!-- Base64 is used for S3/OSS signatures, not for obfuscation. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<severity>0</severity>
	</rule>

	<!-- Silencing is deliberate in file-system probes (set_error_handler). -->
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<severity>0</severity>
	</rule>

	<!-- Unused params are kept for interface compatibility. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>
</ruleset>
